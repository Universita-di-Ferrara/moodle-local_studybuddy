{{!
    @template local_studybuddy/practice_flashcards

    Example context (json): {}
}}
{{#hascards}}
<div class="mx-auto local-studybuddy-flashcards-container"
     data-region="studybuddy-flashcards"
     data-cards='{{{cardsjson}}}'
     data-reveal-label="{{revealanswerlabel}}"
     data-hide-label="{{hideanswerlabel}}"
     data-hint-label="{{hintlabel}}"
     data-citations-label="{{citationslabel}}">
    <article class="p-4 border rounded bg-white local-studybuddy-flashcard shadow-sm">
        <div class="local-studybuddy-flashcard-header">
            <span data-region="flashcard-progress" class="badge badge-light rounded-pill py-1 px-2 border local-studybuddy-flashcard-progress mb-2"></span>
        </div>

        <section class="d-flex align-items-center justify-content-center p-4 rounded bg-white local-studybuddy-flashcard-front">
            <h3 data-region="flashcard-front" class="m-0 local-studybuddy-flashcard-question"></h3>
        </section>

        <section data-region="flashcard-back" class="mt-3 p-3 border rounded bg-light local-studybuddy-flashcard-back d-none">
            <div class="small font-weight-bold text-muted mb-2">{{backlabel}}</div>
            <div data-region="flashcard-answer" class="m-0 local-studybuddy-flashcard-text"></div>
            <div data-region="flashcard-meta"></div>
        </section>

        <div class="d-flex justify-content-center mt-3 local-studybuddy-flashcard-actions">
            <button type="button"
                    class="btn btn-outline-primary rounded-pill local-studybuddy-flashcard-reveal"
                    data-action="reveal-answer">
                {{revealanswerlabel}}
            </button>
        </div>

        <div class="d-flex justify-content-between mt-3 local-studybuddy-flashcard-nav">
            <button type="button" class="btn btn-light" data-action="previous-card">
                &lsaquo; {{previouslabel}}
            </button>
            <button type="button" class="btn btn-light" data-action="next-card">
                {{nextlabel}} &rsaquo;
            </button>
        </div>
    </article>
</div>
{{/hascards}}

{{^hascards}}
<div class="alert alert-warning">{{emptylabel}}</div>
{{/hascards}}
