{{!
    @template local_studybuddy/sources_table

    Example context (json): {}
}}
<div class="local-studybuddy-page pb-5" data-region="studybuddy-sources" data-courseid="{{courseid}}" data-technical-status="1">
    {{#sectionnav}}
        {{> local_studybuddy/section_nav }}
    {{/sectionnav}}

    <div class="d-flex flex-wrap align-items-start justify-content-between mb-3 pb-2 pb-md-3 local-studybuddy-page-header local-studybuddy-page-header-actions">
        <div class="min-width-0">
            <h1 class="m-0 mb-1 local-studybuddy-page-title">{{heading}}</h1>
            <p class="m-0 local-studybuddy-page-copy">{{intro}}</p>
        </div>
        <form method="post" data-studybuddy-loading-form data-action="sync-course-form">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="sync">
            <button class="btn btn-primary" type="submit" data-action="sync-course">
                <i class="fa fa-sync-alt mr-1" aria-hidden="true" data-default-icon="fa-sync-alt"></i>
                <span>{{syncbutton}}</span>
            </button>
        </form>
    </div>

    {{{messagehtml}}}
    <div class="local-studybuddy-sync-status alert {{#statuswarning}}alert-warning{{/statuswarning}}{{^statuswarning}}alert-info{{/statuswarning}} py-2" data-region="studybuddy-status" role="status" aria-live="polite">
        {{statuslabel}}
    </div>

    {{#hassources}}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col">{{#str}} ragdocument:title, local_studybuddy {{/str}}</th>
                        <th scope="col">{{#str}} ragdocument:source, local_studybuddy {{/str}}</th>
                        <th scope="col">{{#str}} ragdocument:status, local_studybuddy {{/str}}</th>
                        <th scope="col">{{#str}} source:enabled, local_studybuddy {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#sources}}
                        <tr data-documentid="{{id}}">
                            <td>{{title}}</td>
                            <td><span class="badge badge-secondary">{{sourcetype}}</span></td>
                            <td>{{status}}</td>
                            <td>
                                <div class="custom-control custom-switch">
                                    <input
                                        type="checkbox"
                                        class="custom-control-input"
                                        id="local-studybuddy-source-{{id}}"
                                        data-action="toggle-source"
                                        {{#enabled}}checked{{/enabled}}>
                                    <label class="custom-control-label" for="local-studybuddy-source-{{id}}">
                                        <span class="sr-only">{{#str}} source:enabled, local_studybuddy {{/str}}</span>
                                    </label>
                                </div>
                            </td>
                        </tr>
                    {{/sources}}
                </tbody>
            </table>
        </div>
    {{/hassources}}
    {{^hassources}}
        <div class="alert alert-warning">{{#str}} noragdocuments, local_studybuddy {{/str}}</div>
    {{/hassources}}
</div>
