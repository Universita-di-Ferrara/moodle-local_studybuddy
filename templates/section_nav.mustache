{{!
    @template local_studybuddy/section_nav

    Example context (json): {}
}}


<nav class="local-studybuddy-section-nav mb-4" aria-label="{{arialabel}}">
    <ul class="nav nav-pills d-flex flex-nowrap overflow-auto px-1 pt-1 pb-2 local-studybuddy-section-nav-list rounded">
        {{#items}}
            <li class="nav-item">
                <a class="nav-link rounded px-2 local-studybuddy-section-nav-link {{#active}}active{{/active}}"
                    href="{{url}}"
                    {{#active}}aria-current="page"{{/active}}>
                    {{label}}
                </a>
            </li>
        {{/items}}
    </ul>
</nav>
