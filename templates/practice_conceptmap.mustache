{{!
    @template local_studybuddy/practice_conceptmap

    Example context (json): {}
}}
{{#hasroot}}
    <div class="d-flex flex-column align-items-center w-100 local-studybuddy-conceptmap local-studybuddy-conceptmap-vertical" data-region="conceptmap">
        <div class="mb-3 local-studybuddy-conceptmap-toolbar btn-group btn-group-sm" role="group" aria-label="{{layoutlabel}}" aria-controls="{{canvasid}}">
            <button
                type="button"
                class="btn btn-outline-secondary btn-sm active"
                data-conceptmap-layout="vertical"
                aria-pressed="true">
                {{verticallabel}}
            </button>
            <button
                type="button"
                class="btn btn-outline-secondary btn-sm"
                data-conceptmap-layout="horizontal"
                aria-pressed="false">
                {{horizontallabel}}
            </button>
        </div>

        <div
            class="mw-100 mx-auto border rounded bg-light local-studybuddy-mindmap-canvas"
            id="{{canvasid}}"
            data-region="studybuddy-mindmap"
            data-mindmap="{{mindmapjson}}"
            role="region"
            aria-busy="true"
            aria-label="{{nodeslabel}}">
        </div>

        <details class="w-100 mw-100 mt-3 p-3 border rounded bg-light local-studybuddy-conceptmap-alternative">
            <summary>{{alternativelabel}}</summary>
            <p class="my-3 local-studybuddy-conceptmap-alternative-help">{{alternativehelp}}</p>
            <ol class="m-0 pl-4 local-studybuddy-conceptmap-outline" role="tree" aria-label="{{nodeslabel}}">
                {{#accessibleroot}}
                    {{> local_studybuddy/conceptmap_node}}
                {{/accessibleroot}}
            </ol>
        </details>
    </div>
{{/hasroot}}
{{^hasroot}}
    <div class="alert alert-warning">{{emptylabel}}</div>
{{/hasroot}}
