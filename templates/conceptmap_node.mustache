{{!
    @template local_studybuddy/conceptmap_node

    Accessible recursive concept map outline.

    Example context (json): {}
}}
<li class="mt-2" role="treeitem" aria-level="{{level}}">
    <strong>{{label}}</strong>
    {{#hasdescription}}
        <p class="mt-1 mb-0">{{description}}</p>
    {{/hasdescription}}
    {{#haschildren}}
        <ol role="group">
            {{#children}}
                {{> local_studybuddy/conceptmap_node}}
            {{/children}}
        </ol>
    {{/haschildren}}
</li>
