{{!
    @template local_studybuddy/chat_page

    Example context (json): {}
}}
<div class="local-studybuddy-page local-studybuddy-chat-shell d-flex flex-column pb-5"
    data-region="studybuddy-chat"
    data-courseid="{{courseid}}"
    data-chatid="{{chatid}}"
    data-technical-status="{{#technicalstatus}}1{{/technicalstatus}}{{^technicalstatus}}0{{/technicalstatus}}"
    data-welcome="{{welcomemessage}}">
    {{#sectionnav}}
        {{> local_studybuddy/section_nav }}
    {{/sectionnav}}

    <div class="local-studybuddy-page-header mb-3 pb-2 pb-md-3">
        <h1 class="m-0 mb-1 local-studybuddy-page-title">{{heading}}</h1>
        <p class="m-0 local-studybuddy-page-copy">{{intro}}</p>
    </div>

    <div class="local-studybuddy-sync-status alert {{#statuswarning}}alert-warning{{/statuswarning}}{{^statuswarning}}alert-info{{/statuswarning}} small mb-3 {{^statuswarning}}d-none{{/statuswarning}}" data-region="studybuddy-status" role="status" aria-live="polite">
        {{statuslabel}}
    </div>

    <div class="local-studybuddy-chat-toolbar d-flex justify-content-end mb-3">
        <button class="btn btn-outline-danger rounded d-inline-flex align-items-center"
            type="button"
            title="{{#str}} clearhistory_help, local_studybuddy {{/str}}"
            aria-label="{{#str}} clearhistory, local_studybuddy {{/str}}"
            data-action="clear-history">
            {{#str}} clearhistory, local_studybuddy {{/str}}
        </button>
    </div>

    <div class="local-studybuddy-messages flex-grow-1 overflow-auto d-flex flex-column mb-3 p-md-1"
        data-region="messages"
        role="log"
        aria-live="off">
        <div class="local-studybuddy-message local-studybuddy-message-assistant entry-animation d-flex align-self-start mb-3">
            <div class="local-studybuddy-message-content">
                <div class="d-inline-block mw-100 p-3 border-0 rounded shadow-sm local-studybuddy-message-text-bubble">
                    <div class="local-studybuddy-message-text text-break">{{#str}} welcomemessage, local_studybuddy {{/str}}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="sr-only" data-region="chat-announcement" role="status" aria-live="polite" aria-atomic="true"></div>

    <div class="local-studybuddy-typing-container d-none mb-3" data-region="typing" role="status" aria-live="polite" aria-atomic="true">
        <div class="d-flex align-items-center">
            <div class="local-studybuddy-typing d-flex mr-2">
                <div class="local-studybuddy-dot"></div>
                <div class="local-studybuddy-dot"></div>
                <div class="local-studybuddy-dot"></div>
            </div>
            <small class="text-muted">{{#str}} assistanttyping, local_studybuddy {{/str}}</small>
        </div>
    </div>

    <form class="local-studybuddy-chat-form d-flex align-items-end mt-auto p-2 border rounded-lg bg-white shadow-sm" data-region="chat-form">
        <label class="sr-only" for="{{inputid}}">{{inputlabel}}</label>
        <textarea class="local-studybuddy-input form-control flex-grow-1 py-2 px-0 border-0 bg-transparent shadow-none"
            id="{{inputid}}"
            rows="1"
            data-region="chat-input"
            data-default-placeholder="{{placeholder}}"
            placeholder="{{placeholder}}"
            aria-describedby="{{inputid}}-help"></textarea>
        <span id="{{inputid}}-help" class="sr-only">{{inputhelp}}</span>
        <span class="align-self-stretch my-1 local-studybuddy-chat-divider" aria-hidden="true"></span>
        <button class="align-self-end flex-shrink-0 local-studybuddy-send-btn btn btn-primary d-flex align-items-center justify-content-center p-0 rounded-lg shadow-none"
            type="submit"
            data-region="chat-submit"
            aria-label="{{sendlabel}}">
            <i class="fa fa-paper-plane" aria-hidden="true"></i>
        </button>
    </form>
</div>
