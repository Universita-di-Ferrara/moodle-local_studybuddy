{{!
    @template local_studybuddy/practice_activity_view

    Student practice activity view with activity navigation.
}}
<a href="{{backurl}}" class="d-inline-flex align-items-center mb-3 local-studybuddy-back-link">
    <span class="mr-2" aria-hidden="true">&larr;</span>
    {{backlabel}}
</a>

<div class="row align-items-start local-studybuddy-practice-activity-layout">
    <main class="col-12 col-lg-8 mb-4 mb-lg-0">
        <div class="p-3 border rounded bg-white local-studybuddy-panel">
            <h2 class="m-0 mb-1 local-studybuddy-section-title">{{resultsheading}}</h2>
            {{{quizhtml}}}
        </div>
    </main>

    <aside class="col-12 col-lg-4 d-flex flex-column local-studybuddy-practice-recent" aria-label="{{recentactivitiesheading}}">
        {{> local_studybuddy/practice_recent_activities}}
    </aside>
</div>
