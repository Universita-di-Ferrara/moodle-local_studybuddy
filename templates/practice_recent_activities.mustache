{{!
    @template local_studybuddy/practice_recent_activities

    Recent student practice activities.
}}
{{#showpending}}
    <div class="alert alert-info local-studybuddy-generation-alert" role="status">
        <h2 class="m-0 mb-1 local-studybuddy-section-title">{{pendingtitle}}</h2>
        <p class="local-studybuddy-section-copy mb-3">{{pendingdescription}}</p>
        <a href="{{refreshurl}}" class="btn btn-outline-primary">{{refreshstatuslabel}}</a>
    </div>
{{/showpending}}

{{#showfailed}}
    <div class="alert alert-danger local-studybuddy-generation-alert" role="alert">
        <h2 class="m-0 mb-1 local-studybuddy-section-title">{{failedtitle}}</h2>
        <p class="local-studybuddy-section-copy mb-0">{{faileddescription}}</p>
    </div>
{{/showfailed}}

<div class="p-0 border rounded bg-white local-studybuddy-panel local-studybuddy-history-panel mb-0">
    <div class="d-flex align-items-center p-3 px-md-4 local-studybuddy-history-panel-header">
        <h2 class="m-0 local-studybuddy-section-title">{{recentactivitiesheading}}</h2>
    </div>
    {{#hasrecentactivities}}
        <div class="list-group list-group-flush local-studybuddy-history-list local-studybuddy-practice-history-list">
                {{#recentactivities}}
                    <div class="list-group-item d-flex justify-content-between  px-3 py-2 local-studybuddy-history-item local-studybuddy-practice-history-item {{#active}}bg-light border-top-0 border-right-0 border-bottom-0 border-left border-primary{{/active}}">
                        <div class="d-flex flex-wrap align-items-center local-studybuddy-history-main">
                            <span class="d-inline-flex align-items-center justify-content-center mr-3 rounded-circle local-studybuddy-card-icon-primary local-studybuddy-practice-history-icon" aria-hidden="true">
                                {{#isquiz}}{{#pix}}i/activities, core{{/pix}}{{/isquiz}}
                                {{#isflashcards}}<i class="fa fa-flash" aria-hidden="true"></i>{{/isflashcards}}
                                {{#isconceptmap}}<i class="fa fa-sitemap" aria-hidden="true"></i>{{/isconceptmap}}
                            </span>
                            <span class="local-studybuddy-history-copy">
                            <a href="{{url}}" class="local-studybuddy-history-link">{{title}}</a>
                            <span>
                                <span class="badge badge-light rounded-pill local-studybuddy-status-badge">{{type}}</span>
                                <span class="badge {{#isfailed}}badge-danger{{/isfailed}}{{#ispending}}badge-info{{/ispending}}{{#isready}}badge-success{{/isready}} rounded-pill local-studybuddy-status-badge">{{status}}</span>
                            </span>
                        </span>
                    </div>
                    <div class="d-flex flex-wrap align-items-center local-studybuddy-history-actions">
                        <form
                            method="post"
                            class="d-flex flex-wrap align-items-center"
                            data-confirm-submit="delete-practice"
                            data-confirm-title="{{deleteconfirmtitle}}"
                            data-confirm-message="{{deleteconfirmbody}}">
                            <input type="hidden" name="courseid" value="{{courseid}}">
                            <input type="hidden" name="practiceid" value="{{id}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="delete">

                                        <button
                                            type="submit"
                                            class="local-studybuddy-delete-button local-studybuddy-icon-button btn btn-outline-danger d-inline-flex align-items-center justify-content-center"
                                title="{{deletebutton}}"
                                aria-label="{{deletebutton}}">
                                {{#pix}}t/delete, core{{/pix}}
                            </button>
                        </form>
                    </div>
                </div>
            {{/recentactivities}}
        </div>
    {{/hasrecentactivities}}
    {{^hasrecentactivities}}
        <p class="m-0 px-3 pb-3 px-md-4 pb-md-4 local-studybuddy-empty-recent">{{emptyrecentactivities}}</p>
    {{/hasrecentactivities}}
</div>
