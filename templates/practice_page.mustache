{{!
    @template local_studybuddy/practice_page

    Student practice page.

    Example context (json): {}
}}
<div class="local-studybuddy-shell local-studybuddy-shell-practice pb-0 pb-lg-3 pt-1 rounded-0" data-region="studybuddy-practice">
    {{#sectionnav}}
        {{> local_studybuddy/section_nav }}
    {{/sectionnav}}

    <div class="local-studybuddy-page-header mb-3 pb-2 pb-md-3">
        <h1 class="m-0 mb-1 local-studybuddy-page-title">{{herotitle}}</h1>
        <p class="m-0 local-studybuddy-page-copy">{{herolead}}</p>
    </div>

    {{{messagehtml}}}

    {{^showresults}}
        <div class="align-items-start mb-3 local-studybuddy-practice-layout">
            <div class="local-studybuddy-practice-create">
                {{> local_studybuddy/practice_generate_form}}
            </div>
            <div class="d-flex flex-column local-studybuddy-practice-recent">
                {{> local_studybuddy/practice_recent_activities}}
            </div>
        </div>
    {{/showresults}}

    {{#showresults}}
        {{> local_studybuddy/practice_activity_view}}
    {{/showresults}}
</div>
