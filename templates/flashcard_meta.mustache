{{!
    @template local_studybuddy/flashcard_meta

    Renders optional flashcard hint and source references.

    Context variables required for this template:
        * hashint - boolean, whether a hint is available
        * hintlabel - hint label
        * hint - hint text
        * hascitations - boolean, whether source references are available
        * citationslabel - source section label
        * citations - list of source references with label

    Example context (json):
    {
        "hashint": true,
        "hintlabel": "Hint",
        "hint": "Recall the main definition.",
        "hascitations": true,
        "citationslabel": "Sources",
        "citations": [
            {"label": "Course document"}
        ]
    }
}}
<div class="local-studybuddy-flashcard-meta">
    {{#hashint}}
    <div class="mt-3 local-studybuddy-flashcard-hint">
        <strong>{{hintlabel}}:</strong> {{hint}}
    </div>
    {{/hashint}}
    {{#hascitations}}
    <div class="local-studybuddy-citations mt-3">
        <strong>{{citationslabel}}</strong>
        {{#citations}}<span class="badge badge-light rounded-pill ml-1">{{label}}</span>{{/citations}}
    </div>
    {{/hascitations}}
</div>
